<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Pruebas de lo que no necesita Windows: leer la configuración y el estado
    del agente, citar argumentos y decidir qué enseña la ventana. Corren en
    Linux, sin paquetes:  dotnet run
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- El agente llama al registro y al spooler de Windows; aquí solo se prueba lo que no los toca. -->
    <NoWarn>$(NoWarn);CA1416;SYSLIB0014</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Pruebas.cs;PruebasAgente.cs" />
    <Compile Include="../src/Json.cs;../src/Modelo.cs;../src/Argumentos.cs;../src/Situacion.cs;../src/Rutas.cs" />
    <Compile Include="../src/agente/*.cs" />
  </ItemGroup>
</Project>
