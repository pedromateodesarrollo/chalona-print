<Project Sdk="Microsoft.NET.Sdk">
  <!--
    print-server para Windows: el agente, la ventana, el icono de la bandeja y
    el servicio que lo mantiene vivo. Un solo .exe, todo en C#.

    .NET Framework 4.8 porque viene con Windows 10 y 11: el .exe corre sin
    instalar nada más. Compila en Linux (no hace falta Windows para el paquete).

    Sale uno por arquitectura, cada uno con su PDFium dentro: x86 (Windows de
    32 bits; también corre en los de 64) y x64.

      ./compilar.sh                                 los dos paquetes, con PDFium
      dotnet build -c Release                       solo para comprobar que compila
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <Arquitectura Condition="'$(Arquitectura)' == ''">x64</Arquitectura>
    <PlatformTarget>$(Arquitectura)</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <AssemblyName>print-server</AssemblyName>
    <RootNamespace>PrintServer</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <Version>0.6.0</Version>
    <Product>print-server</Product>
    <Company>print-server</Company>
    <Description>print-server: agente de impresión</Description>
    <Copyright>Licencia MIT</Copyright>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <ApplicationIcon>icono.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- El motor de PDF (PDFium) de esta arquitectura y sus licencias: el agente imprime PDF por el driver con él. -->
    <PdfiumDll Condition="'$(PdfiumDll)' == ''">$(MSBuildThisFileDirectory)dist/pdfium-$(Arquitectura)/pdfium.dll</PdfiumDll>
    <PdfiumLicencias Condition="'$(PdfiumLicencias)' == ''">$(MSBuildThisFileDirectory)dist/pdfium-licencias.txt</PdfiumLicencias>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="src/**/*.cs" />
    <EmbeddedResource Include="icono.ico" LogicalName="icono.ico" />
    <EmbeddedResource Include="$(PdfiumDll)" LogicalName="pdfium.dll" Condition="Exists('$(PdfiumDll)')" />
    <EmbeddedResource Include="$(PdfiumLicencias)" LogicalName="pdfium-licencias.txt" Condition="Exists('$(PdfiumLicencias)')" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.ServiceProcess" />
  </ItemGroup>

  <ItemGroup>
    <!-- Para compilar en cualquier sistema sin tener instalado el .NET Framework. -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <!--
    Sin PDFium el paquete instala, pero no imprime PDF por el driver: para
    publicar, compilar.sh pasa ExigirPdfium=true y así no sale uno por descuido.
  -->
  <Target Name="ExigePdfium" BeforeTargets="BeforeBuild" Condition="'$(ExigirPdfium)' == 'true' And !Exists('$(PdfiumDll)')">
    <Error Text="No encuentro pdfium.dll en $(PdfiumDll). compilar.sh lo baja." />
  </Target>
</Project>
